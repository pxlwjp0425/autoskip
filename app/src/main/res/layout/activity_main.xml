<?xml version="1.0" encoding="utf-8"?>
<!--
  外壳：底部导航 + 页面容器。四个页面各自在 page_*.xml 里，靠 visibility 切换。

  为什么用 include + FrameLayout 包一层、而不是 Fragment / ViewPager：
  这个工程是**零第三方依赖**的（只吃 Android 框架自带 API，不需要 androidx），
  没有 FragmentActivity、没有 ViewPager2。include 全部页面一起 inflate 还有一个
  额外好处 —— 切页时各页的滚动位置会保留，回来不会跳回顶部。

  ⚠️ 被 include 的页面里所有 id 在同一个 Activity 里必须唯一（四页同时存在），
  拆分时已经保证，加新控件时注意别撞。

  标题也交给各页自绘：MIUI/HyperOS 的 ActionBar 会盖在内容之上，主题用的是
  Theme.DeviceDefault.Light.NoActionBar（见 values/themes.xml）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/page_home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pageApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include layout="@layout/page_apps" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pageRules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include layout="@layout/page_rules" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include layout="@layout/page_settings" />
        </FrameLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/icHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/lbHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/tab_home"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/icApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/lbApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/tab_apps"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/icRules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☰"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/lbRules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/tab_rules"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/icSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/lbSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/tab_settings"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
