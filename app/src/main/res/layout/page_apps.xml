<?xml version="1.0" encoding="utf-8"?>
<!--
  「应用」页 —— 仿 GKD 的应用列表：搜索 / 筛选 / 逐应用开关，点进去看该应用的规则组。

  这一页**故意不套 ScrollView**：列表要自己滚。外壳（底部导航 + 页面容器）在
  activity_main.xml，本文件只放这一页的内容，高度靠 match_parent 撑满容器。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingTop="20dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:text="@string/tab_apps"
        android:textColor="@color/text_main"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAppListInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/app_list_loading"
        android:textColor="@color/text_sub"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_search_app"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="44dp"
        android:textColor="@color/text_main"
        android:textColorHint="#FFA0A39C"
        android:textSize="14sp" />

    <!-- 筛选：选中的那个用品牌色 + 加粗，不额外引入 drawable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filter_all" />

        <Button
            android:id="@+id/btnFilterRules"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="@string/filter_rules" />

        <Button
            android:id="@+id/btnFilterOff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:text="@string/filter_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToOutline="true"
        android:orientation="vertical">

        <ListView
            android:id="@+id/lvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/divider"
            android:dividerHeight="1dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvAppListEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/app_list_empty"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnResetApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/btn_reset_apps"
        android:textColor="@color/danger"
        android:visibility="gone" />

</LinearLayout>
